# Скопировать в .env и заполнить.
BOT_TOKEN=
SCHEDULE_API_BASE=https://stankinapp.ru
SCHEDULE_GROUPS_PATH=/api/groups
SCHEDULE_PATH=/api/schedule
SCHEDULE_GROUP_PARAM=groupName
SCHEDULE_START_PARAM=startDate
SCHEDULE_END_PARAM=endDate
SCHEDULE_DATE_FORMAT=%Y-%m-%d
SCHEDULE_DAY_TTL_S=900
WINDOW_MIN_GAP_MIN=45
# Запасной URL со списком групп (JSON), если основной /api/groups недоступен.
# Каскад: основной API -> GROUPS_JSON_URL -> data/groups_cache.json (сид из 286 групп).
GROUPS_JSON_URL=
GROUPS_CACHE_FILE=data/groups_cache.json
GROUPS_CACHE_TTL_H=168
INSTITUTION_TZ=Europe/Moscow
OSRM_BASE=https://router.project-osrm.org
# Пешеходный провайдер: FOSSGIS (у OSRM-демо пеший профиль совпадает с автомобильным).
FOOT_BASE=https://routing.openstreetmap.de
NOMINATIM_BASE=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=student-schedule-bot/0.1 (contact: you@example.com)
BUILDINGS_FILE=buildings.yaml
METRO_DATA_FILE=data/metro_moscow.json
DATABASE_PATH=bot_data.sqlite3
# Postgres (Supabase) — если задан, используется вместо sqlite-файла.
# Session pooler URI из Dashboard.
DATABASE_URL=
# Публичный домен сервиса (Render External URL) — для ссылки iOS-ключа.
PUBLIC_BASE_URL=
# 2GIS Routing API: пешком и метро. Ключ — UUID 8-4-4-4-12 (36 символов).
GIS_API_KEY=
# Погода (WeatherAPI.com): ключ с https://www.weatherapi.com/my/ (free-план).
# Пусто — поле weather: null.
WEATHERAPI_KEY=
# /admin: токен доступа; пусто — панель отключена (404).
ADMIN_TOKEN=
DEFAULT_BUFFER_MIN=10
DEFAULT_EVENING_TIME=21:00
DEFAULT_MORNING_MIN_BEFORE_EXIT=60
PORT=10000
LOG_LEVEL=INFO
